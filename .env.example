# Copie para .env.local e preencha. NUNCA versione .env.local.
# SPEC §5.3 e §7.3

# Supabase — projeto ewaygxcrxmrppnntvfzw
NEXT_PUBLIC_SUPABASE_URL=https://ewaygxcrxmrppnntvfzw.supabase.co

# Chave pública (novo formato, sb_publishable_...). É segura no cliente PORQUE o RLS existe.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave anon legada (JWT), para libs que ainda a esperam.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# A service_role IGNORA o RLS por completo.
# Só no servidor, nunca em componente cliente, nunca com prefixo NEXT_PUBLIC_.
# Uso restrito à criação de usuário pelo admin. Qualquer outro uso é bug de segurança.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_TZ=America/Sao_Paulo
